    .product-divider
      .product-divider__line

    //- 05 - Ottocento
    .product-card
      .product-card__image-wrap
        a.gallery-ottocento-js(href="resources/img/bs/ottocento-5.jpg")
          img(src="resources/img/bs/ottocento-5.jpg" alt="Dekorační stěrka Ottocento OIKOS")
        .decor-img__overlay
