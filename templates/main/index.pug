        a.gallery-romano-js(href="resources/img/bs/travertino-romano-1.jpg" alt="Dekorační stěrka Travertino Romano OIKOS")
        a.gallery-romano-js(href="resources/img/bs/travertino-romano-3.jpg" alt="Dekorační stěrka Travertino Romano OIKOS")
