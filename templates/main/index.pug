        a.gallery-encanto-js(href="resources/img/bs/encanto-4.jpg" alt="Dekorační stěrka Encanto OIKOS")
        a.gallery-encanto-js(href="resources/img/bs/encanto-5.jpg" alt="Dekorační stěrka Encanto OIKOS")
        a.gallery-encanto-js(href="resources/img/bs/encanto-6.jpg" alt="Dekorační stěrka Encanto OIKOS")
        a.gallery-encanto-js(href="resources/img/bs/encanto-9.jpg" alt="Dekorační stěrka Encanto OIKOS")
        a.gallery-encanto-js(href="resources/img/bs/encanto-10.jpg" alt="Dekorační stěrka Encanto OIKOS")
        a.gallery-encanto-js(href="resources/img/bs/encanto-11.jpg" alt="Dekorační stěrka Encanto OIKOS")
        a.gallery-encanto-js(href="resources/img/bs/encanto-12.jpg" alt="Dekorační stěrka Encanto OIKOS")
      .product-card__content
        span.product-card__number 04
        h3.product-card__name Encanto
        p.product-card__desc ENCANTO je dekorativní metalický nátěr, který umožňuje vytvořit fascinující povrchové úpravy. Kreativní materiál vytváří magický efekt hry světla a metalických odlesků v nepřeberném množství odstínů ve třech základních bázích Gold, Silver a Grey a nově v dalších čtyřech bázích Oro, Rosso, Bianco a Nero. Encanto je jednoduchým a efektivním řešením pro dosažení jedinečných sofistikovaných dekorací. Snadnou aplikací moderního materiálu dosáhnete rychle elegantního vzhledu metalického povrchu. Vyniká na velkých plochách i v členitých interiérech, v soukromém nebo komerčním prostředí.
        .product-card__variants
          figure
            a(href="resources/img/color-en-gold-.jpg" data-featherlight="image")
              img.color__img(src="resources/img/color-en-gold-.jpg" alt="Gold-")
            figcaption Gold-
          figure
            a(href="resources/img/color-en-gold01.jpg" data-featherlight="image")
              img.color__img(src="resources/img/color-en-gold01.jpg" alt="Gold01")
            figcaption Gold01
          figure
            a(href="resources/img/color-en-gold02.jpg" data-featherlight="image")
              img.color__img(src="resources/img/color-en-gold02.jpg" alt="Gold02")
            figcaption Gold02
          figure
            a(href="resources/img/color-en-gold03.jpg" data-featherlight="image")
              img.color__img(src="resources/img/color-en-gold03.jpg" alt="Gold03")
            figcaption Gold03
        .product-card__accent
        .product-card__icons
          a.product-card__icon-link.product-card__gallery-trigger(href="#")
            svg(width="100%" height="100%" viewbox="0 0 90 69")
              use(xlink:href="#gallery-icon")
          a.product-card__icon-link(href="/resources/files/encanto.pdf" target="_blank")
