extends ../layout.pug

block vars
  -var title = "Radek Tlach | Dekorační stěrky, malby, nátěry | Aracolor.cz"
  -var description = "Luxusní dekorační interiérové stěrky, originální design i maximální odolnost, neomezené množství dekorů a barevných kombinací."
  -var activePage = "index"

block index

  //- Hero Section
  section.hero-section#header
    include ../navigation.pug

    .hero__bg(style="background-image: url('resources/img/hero-sterky.png')")
    .hero__overlay
    .hero__bottom-gradient
    .hero__accent-line

    .hero__content
      .hero__tagline
        span.hero__tagline-dash
        span.hero__tagline-text DEKORAČNÍ STĚRKY &amp; MALÍŘSKÉ PRÁCE

      h1.hero__headline Luxusní povrchy,<br>které inspirují

      p.hero__subtext Originální design a řemeslná preciznost. Dekorační stěrky,<br>benátské štuky a unikátní povrchové úpravy pro váš interiér.

      .hero__cta
        a.hero__btn.hero__btn--primary.scroll-js(href="#kontakty")
          i.ion-ios-email-outline.hero__btn-icon
          | Kontaktujte nás
        a.hero__btn.hero__btn--secondary(href="reference.html")
          i.ion-images.hero__btn-icon
          | Naše reference

    .hero__stats
      .hero__stat
        span.hero__stat-value 15+
        span.hero__stat-label let zkušeností
      .hero__stat-divider
      .hero__stat
        span.hero__stat-value 500+
        span.hero__stat-label realizací
      .hero__stat-divider
      .hero__stat
        span.hero__stat-value 100%
        span.hero__stat-label spokojenost

    .hero__scroll
      .hero__scroll-line
      span.hero__scroll-text scroll

  //- Products Section
  section.section-products
    .row
      .products__header
        .products__tag
          span.products__tag-dash
          span.products__tag-text NAŠE SPECIALIZACE
          span.products__tag-dash
        h2.products__title Druhy povrchů, které umíme
        p.products__subtitle Každý povrch je originál — vytvořený s precizností a vášní pro detail

    //- 01 - Betonové stěrky
    .product-card
      .product-card__image-wrap
        a.gallery-concrete-js(href="resources/img/bs/concrete-1.png")
          img(src="resources/img/bs/concrete-1.png" alt="Betonová stěrka")
        .decor-img__overlay
          p.decor-img__text Otevřít Galerii
        a.gallery-concrete-js(href="resources/img/bs/concrete-2.jpg" alt="Betonová stěrka")
        a.gallery-concrete-js(href="resources/img/bs/concrete-3.jpg" alt="Betonová stěrka")
      .product-card__content
        span.product-card__number 01
        h3.product-card__name Betonové stěrky
        p.product-card__desc Betonová stěrka neboli imitace pohledového betonu, se postupně stala nepostradatelným prvkem moderní architektury. Dá se nanést na stěnu, podlahu i strop. Použití je možné i do koupelny či na fasády budov.
        .product-card__accent
        .product-card__icons
          a.product-card__icon-link.product-card__gallery-trigger(href="#")
            svg(width="100%" height="100%" viewbox="0 0 90 69")
              use(xlink:href="#gallery-icon")

    .product-divider
      .product-divider__line

    //- 02 - Arte Viva
    .product-card.product-card--reverse
      .product-card__image-wrap
        a.gallery-arteviva-js(href="resources/img/bs/arteviva-8.jpg")
          img(src="resources/img/bs/arteviva-8.jpg" alt="Dekorační stěrka Arte Viva")
        .decor-img__overlay
          p.decor-img__text Otevřít Galerii
        a.gallery-arteviva-js(href="resources/img/bs/arteviva-2.jpg" alt="Dekorační stěrka Arte Viva")
        a.gallery-arteviva-js(href="resources/img/bs/arteviva-3.jpg" alt="Dekorační stěrka Arte Viva")
        a.gallery-arteviva-js(href="resources/img/bs/arteviva-4.jpg" alt="Dekorační stěrka Arte Viva")
        a.gallery-arteviva-js(href="resources/img/bs/arteviva-5.jpg" alt="Dekorační stěrka Arte Viva")
        a.gallery-arteviva-js(href="resources/img/bs/arteviva-6.jpg" alt="Dekorační stěrka Arte Viva")
        a.gallery-arteviva-js(href="resources/img/bs/arteviva-7.jpg" alt="Dekorační stěrka Arte Viva")
        a.gallery-arteviva-js(href="resources/img/bs/arteviva-1.jpg" alt="Dekorační stěrka Arte Viva")
      .product-card__content
        span.product-card__number 02
        h3.product-card__name Arte Viva
        p.product-card__desc Systém ARTE VIVA představuje dokonalé spojení všestranosti a přizpůsobitelnosti jakýmkoli požadavkům, prostředí, vybavení a nabízí možnost vytvářet umělecké a dekorativní efekty. Proto je ideálním řešením pro jedinečnou a originální úpravu soukromích i veřejných prostorů, obchodů, kanceláří, koupelen, sprchových koutů a podlah.
        .product-card__accent
        .product-card__icons
          a.product-card__icon-link.product-card__gallery-trigger(href="#")
            svg(width="100%" height="100%" viewbox="0 0 90 69")
              use(xlink:href="#gallery-icon")
          a.product-card__icon-link(href="https://www.resinaarteviva.it/cs/" target="_blank")
            svg(width="100%" height="100%" viewbox="0 0 31 31")
              use(xlink:href="#website-icon")

    .product-divider
      .product-divider__line

    //- 03 - Aureum
    .product-card
      .product-card__image-wrap
        a.gallery-aureum-js(href="resources/img/bs/aureum-8.jpg")
          img(src="resources/img/bs/aureum-8.jpg" alt="Dekorační stěrka Aureum OIKOS")
        .decor-img__overlay
          p.decor-img__text Otevřít Galerii
        a.gallery-aureum-js(href="resources/img/bs/aureum-1.jpg" alt="Dekorační stěrka Aureum OIKOS")
        a.gallery-aureum-js(href="resources/img/bs/aureum-2.jpg" alt="Dekorační stěrka Aureum OIKOS")
        a.gallery-aureum-js(href="resources/img/bs/aureum-3.jpg" alt="Dekorační stěrka Aureum OIKOS")
        a.gallery-aureum-js(href="resources/img/bs/aureum-4.jpg" alt="Dekorační stěrka Aureum OIKOS")
        a.gallery-aureum-js(href="resources/img/bs/aureum-5.jpg" alt="Dekorační stěrka Aureum OIKOS")
        a.gallery-aureum-js(href="resources/img/bs/aureum-6.jpg" alt="Dekorační stěrka Aureum OIKOS")
        a.gallery-aureum-js(href="resources/img/bs/aureum-7.jpg" alt="Dekorační stěrka Aureum OIKOS")
        a.gallery-aureum-js(href="resources/img/bs/aureum-9.jpg" alt="Dekorační stěrka Aureum OIKOS")
        a.gallery-aureum-js(href="resources/img/bs/aureum-10.jpg" alt="Dekorační stěrka Aureum OIKOS")
      .product-card__content
        span.product-card__number 03
        h3.product-card__name Aureum
        p.product-card__desc AUREUM je prestižní dekorativní materiál, který vytváří nádherný efekt "zlatého mramoru". Jeho barevnost vychází ze zemitých odstínů a teplých přírodních tónů. Konečný efekt je navíc znásoben zlatými odlesky, které prozařují stěnu a vzbuzují intenzivní pocity hedvábného doteku. AUREUM představuje jedinečné spojení lehkosti a elegance vzhledu přírodního hedvábí s odolností a pevností mramorového povrchu. Aureum je nabízeno v osmi odstínech.
        .product-card__variants
          figure
            a(href="resources/img/color-au-16-melia.jpg" data-featherlight="image")
              img.color__img(src="resources/img/color-au-16-melia.jpg" alt="Au 16 Melia")
            figcaption Au 16 Melia
          figure
            a(href="resources/img/color-au-24-gea.jpg" data-featherlight="image")
              img.color__img(src="resources/img/color-au-24-gea.jpg" alt="Au 34 Gea")
            figcaption Au 34 Gea
          figure
            a(href="resources/img/color-au-32-arcadia.jpg" data-featherlight="image")
              img.color__img(src="resources/img/color-au-32-arcadia.jpg" alt="Au 32 Arcadia")
            figcaption Au 32 Arcadia
          figure
            a(href="resources/img/color-au-40-rea.jpg" data-featherlight="image")
              img.color__img(src="resources/img/color-au-40-rea.jpg" alt="Au 40 Rea")
            figcaption Au 40 Rea
        .product-card__accent
        .product-card__icons
          a.product-card__icon-link.product-card__gallery-trigger(href="#")
            svg(width="100%" height="100%" viewbox="0 0 90 69")
              use(xlink:href="#gallery-icon")
          a.product-card__icon-link(href="/resources/files/aureum.pdf" target="_blank")
            svg(width="100%" height="100%" viewbox="0 0 81 100")
              use(xlink:href="#pdf-icon")
          a.product-card__icon-link(href="http://www.oikos-group.it/en/p/aureum" target="_blank")
            svg(width="100%" height="100%" viewbox="0 0 31 31")
              use(xlink:href="#website-icon")

    .product-divider
      .product-divider__line

    //- 04 - Encanto
    .product-card.product-card--reverse
      .product-card__image-wrap
        a.gallery-encanto-js(href="resources/img/bs/encanto-7.jpg")
          img(src="resources/img/bs/encanto-7.jpg" alt="Dekorační stěrka Encanto OIKOS")
        .decor-img__overlay
          p.decor-img__text Otevřít Galerii
        a.gallery-encanto-js(href="resources/img/bs/encanto-1.jpg" alt="Dekorační stěrka Encanto OIKOS")
        a.gallery-encanto-js(href="resources/img/bs/encanto-2.jpg" alt="Dekorační stěrka Encanto OIKOS")
