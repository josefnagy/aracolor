extends ../layout.pug

block vars
  -var title = "Malířské práce | Radek Tlach | Aracolor.cz"
  -var description = "To co je pro ostatní problém, je pro Nás výzva, a proto se nezaleknem žádné zakázky, ať už se jedná o natření plotu nebo o vymalování výrobní haly."

block index
  header#header.header

    include ../navigation.pug
    .hero
      .header__hero-box
        h1.header__heading.animated.bounceInLeft Malířské práce
        p.header__text.animated.bounceInRight
          | Kompletní malířské a natěračské práce v interiéru i exteriéru, profesionální přístup a špičková kvalita.
      .header__arrows
        a.header__arrows--prev(href="#")
          span.header__icon-wrap
            svg.header__icon(width="32" height="32" viewbox="0 0 64 64")
              use(xlink:href="#arrow-left-5")
          img(src="resources/img/arrow-natery.png" alt="Sekce nátěry")
        a.header__arrows--next(href="#")
          span.header__icon-wrap
            svg.header__icon(width="32" height="32" viewbox="0 0 64 64")
              use(xlink:href="#arrow-right-5")
          img(src="resources/img/arrow-malby.png" alt="Sekce malby")
      .header__scrolldown-anim
        a.scrolldown-anim__link(href="#")
          span.scrolldown-anim__link--inner
      a.btn--back-to-top(href="#")
        i.ion-ios-arrow-up

  section#features.section-why-us
    .row
      h2.why-us__heading Svěřte interiér i exteriér profesionálům
      p.long-copy
        | To co je pro ostatní problém, je pro Nás výzva, a proto se nezaleknem žádné zakázky, ať už se jedná o natření plotu nebo o vymalování výrobní haly.
    .row
      .col.span-1-of-4.box
        i.icon-big.ion-ios-checkmark-empty
        h3 Zkušenost
        p
          | Více než 22 let v oboru.
      .col.span-1-of-4.box
        i.icon-big.ion-ios-star-outline
        h3 Kvalita
        p
          | Za Naší prací si stojíme, proto se nebojíme dávat 24 - měsíční záruku na dílo.
      .col.span-1-of-4.box
        i.icon-big.ion-ios-speedometer-outline
        h3 Rychlost
        p
          | Jsme placeni od metrů, ne od hodiny a proto se můžete spolehnout, že práce bude odsýpat.
      .col.span-1-of-4.box
        i.icon-big.ion-ios-trash-outline
        h3 Čistota
        p
          | Úklid po malování je pro Nás samozřejmostí.

  section.section-gallery
    ul.gallery__showcase.clearfix
      li.gallery__list
        figure.gallery__photo
          img.gallery__photo--img(src="resources/img/galerie-1.jpg" alt="Ukázka dekorační stěrky")
      li.gallery__list
