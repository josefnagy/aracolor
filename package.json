{
  "name": "aracolor",
  "version": "1.0.0",
  "description": "aracolor static website",
  "main": "index.html",
  "scripts": {
    "build:css": "sass sass/main.scss:public/resources/css/style.css --watch --no-source-map --silence-deprecation=import",
    "build:css:once": "sass sass/main.scss:public/resources/css/style.css --no-source-map --silence-deprecation=import",
    "build:html": "pug templates/main --out public -w -P",
    "build:html:once": "pug templates/main --out public -P",
    "dev": "concurrently --kill-others \"npm run build:html\" \"npm run build:css\" \"browser-sync start --server public --files 'public/**/*'\"",
    "build": "npm run build:css:once && npm run build:html:once",
    "deploy": "npx firebase-tools deploy --only hosting",
    "process:images": "node js/processImages.js",
    "deploy-vm": "rsync -avz --delete public/ jnagy@84.247.162.208:/var/www/aracolor/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josefnagy/aracolor.git"
  },
  "keywords": [
    "aracolor"
  ],
  "author": "Josef Nagy",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/josefnagy/aracolor/issues"
  },
  "homepage": "https://github.com/josefnagy/aracolor#readme",
  "devDependencies": {
    "browser-sync": "^2.29.3",
    "chalk": "^4.1.2",
    "concurrently": "^9.1.0",
    "npm-run-all": "^4.1.5",
    "pug": "^3.0.3",
    "pug-cli": "^1.0.0-alpha6",
    "sass": "^1.83.0",
    "sharp": "^0.34.0"
  }
}
